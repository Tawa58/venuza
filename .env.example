# Names only. Copy to .env and fill values on the machine that needs them.
# .env is gitignored. Do not commit values.
# Server-only names are read by apps/api or the migration command.
# They must not use the NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix.

# Firebase — public, mobile (apps/mobile)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase — public, web (apps/web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — server-only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Neon PostgreSQL — server-only
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2 — server-only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Brevo — server-only
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Paynow — server-only
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Expo push — server-only, used when push is implemented
EXPO_ACCESS_TOKEN=

# Public origins
APP_PUBLIC_URL=
API_PUBLIC_URL=
NEXT_PUBLIC_API_URL=
EXPO_PUBLIC_API_URL=
